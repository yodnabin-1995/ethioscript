# ═══════════════════════════════════════════════════════════════════════════════
# EthioScript & Voice AI — Environment Configuration
# Copy to .env and fill in ALL values. NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Environment ──────────────────────────────────────────────────────────────
ENV=development                         # development | staging | production

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=ethio
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ethioscript

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_12chars_min
MINIO_BUCKET=ethioscript-assets

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=ethio
RABBITMQ_PASSWORD=change_me_rabbit_password
RABBITMQ_VHOST=ethioscript

# ─── Account Service (JWT / Auth) ─────────────────────────────────────────────
# Must be at least 32 characters for HS256 — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_32plus_char_secret_here
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=7
EMAIL_VERIFY_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_MINUTES=30

# ─── Internal service-to-service key ─────────────────────────────────────────
# Shared secret used between microservices
INTERNAL_API_KEY=change_me_internal_service_key

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=20

# ─── OCR Worker ───────────────────────────────────────────────────────────────
OCR_LANGUAGE=amh+eng        # amh=Amharic, eng=English, tir=Tigrinya, orm=Oromo

# ─── STT Worker (Release 2) ───────────────────────────────────────────────────
STT_MODEL=whisper-small     # whisper-tiny | whisper-small | whisper-medium
STT_LANGUAGE=am             # am=Amharic, ti=Tigrinya

# ─── Admin Tools ──────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@ethioscript.io
PGADMIN_PASSWORD=change_me_pgadmin_password
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_password

# ─── Swagger ──────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true

# ─── AI Chat Service ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AI_SERVICE_SECRET=change_me_ai_secret_32chars

# LLM provider: mock | openai | groq | ollama
LLM_PROVIDER=mock
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_BASE_URL=

# Voice
WHISPER_MODEL=whisper-large-v3-turbo
TTS_PROVIDER=gtts
MAX_AUDIO_MB=25

# Chat tuning
MAX_CONTEXT_MESSAGES=20
CHAT_RATE_LIMIT_RPM=30

# ─── Notification Service ─────────────────────────────────────────────────────
# Generate VAPID keys: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key); print(v.private_key)"
# Leave blank to disable Web Push (service still starts — push delivery will be skipped)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:api@ethioscript.io
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OUTBOX_POLL_SECONDS=5
NOTIFICATION_TTL_DAYS=30
