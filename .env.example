# ═══════════════════════════════════════════════════════════════════════════════
# EthioScript & Voice AI — Environment Configuration
# Copy to .env and fill in ALL values. NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Environment ──────────────────────────────────────────────────────────────
ENV=development                         # development | staging | production

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=ethio
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ethioscript

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_12chars_min
MINIO_BUCKET=ethioscript-assets

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=ethio
RABBITMQ_PASSWORD=change_me_rabbit_password
RABBITMQ_VHOST=ethioscript

# ─── Account Service (JWT / Auth) ─────────────────────────────────────────────
# Must be at least 32 characters for HS256 — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_32plus_char_secret_here
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=7
EMAIL_VERIFY_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_MINUTES=30

# ─── Internal service-to-service key ─────────────────────────────────────────
# Shared secret used between microservices
INTERNAL_API_KEY=change_me_internal_service_key

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=20

# ─── OCR Worker ───────────────────────────────────────────────────────────────
OCR_LANGUAGE=amh+eng        # amh=Amharic, eng=English, tir=Tigrinya, orm=Oromo

# ─── STT Worker (Release 2) ───────────────────────────────────────────────────
STT_MODEL=whisper-small     # whisper-tiny | whisper-small | whisper-medium
STT_LANGUAGE=am             # am=Amharic, ti=Tigrinya

# ─── Admin Tools ──────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@ethioscript.io
PGADMIN_PASSWORD=change_me_pgadmin_password
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_password

# ─── Swagger ──────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
