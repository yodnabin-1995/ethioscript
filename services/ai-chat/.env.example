# ── EthioScript AI Chat Service — Environment Variables ──────────────────────
# Copy to .env and fill in values. NEVER commit .env.

# Required — shared secret between Next.js and this service
# Generate with: openssl rand -hex 32
AI_SERVICE_SECRET=change_me_use_openssl_rand_hex_32

# ── LLM Provider (choose one) ─────────────────────────────────────────────────

# Option A — OpenAI
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...

# Option B — Groq (fast, free tier available — https://console.groq.com)
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=gsk_...

# Option C — Ollama (local, no key needed — https://ollama.com)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434

# Option D — Mock (for UI testing only, no real LLM calls)
# LLM_PROVIDER=mock

# ── Service connections ───────────────────────────────────────────────────────
DOCUMENT_SERVICE_URL=http://document-service:6001
INTERNAL_API_KEY=change_me_internal_service_key
REDIS_URL=redis://:change_me_redis_password@redis:6379/2

# ── Tunables ──────────────────────────────────────────────────────────────────
MAX_CONTEXT_MESSAGES=20       # messages sent to LLM per request (token budget)
CHAT_RATE_LIMIT_RPM=30        # max requests per minute per user
CHAT_HISTORY_TTL_SEC=86400    # conversation history TTL in Redis (24 h)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
